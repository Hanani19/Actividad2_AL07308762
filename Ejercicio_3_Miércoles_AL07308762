print("\nEjercicio 3: ¿Cuánto escucho a mi artista favorito?")
print("\nMI ARTISTA FAVORITO\n")

artista = "Humbe"
canciones_por_día = 8
duracion_promedio = 4.0 # minutos por canción

minutos_día = canciones_por_día * duracion_promedio # minutos al día
minutos_anio = minutos_día * 365.                   # minutos al año
horas_anio = minutos_anio / 60                      # 1 hora = 60 minutos
dias_anio = horas_anio / 24                         # 1 día = 24 horas

print(f"Escuchas a {artista} {minutos_día} minutos al día")
print(f"Al año son {minutos_anio} minutos")
print(f"Eso equivale a {horas_anio:.1f} horas")
print(f"¡0 sea {dias_anio:.1f} días completos escuchando a {artista}!\n")